{
  "name": "@yunuspi/coding-agent",
  "version": "0.6.3",
  "description": "Coding agent CLI with read, bash, edit, write tools and session management",
  "type": "module",
  "piConfig": {
    "configDir": ".pi"
  },
  "bin": {
    "yunuspi": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rpc-entry": {
      "import": "./dist/rpc-entry.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-core.mjs"
  },
  "dependencies": {
    "@yunuspi/chord": "0.6.3",
    "@yunuspi/agent-core": "0.6.3",
    "@yunuspi/ai": "0.6.3",
    "@yunuspi/tui": "0.6.3",
    "@silvia-odwyer/photon-node": "0.3.4",
    "chalk": "5.6.2",
    "cross-spawn": "7.0.6",
    "diff": "8.0.4",
    "grok-mermaid": "0.2.2",
    "highlight.js": "10.7.3",
    "hosted-git-info": "9.0.3",
    "ignore": "7.0.5",
    "jiti": "2.7.0",
    "minimatch": "10.2.5",
    "proper-lockfile": "4.1.2",
    "semver": "7.8.0",
    "typebox": "1.3.7",
    "undici": "8.9.0",
    "yaml": "2.9.0"
  },
  "optionalDependencies": {
    "@mariozechner/clipboard": "0.3.9"
  },
  "keywords": [
    "coding-agent",
    "ai",
    "llm",
    "cli",
    "tui",
    "agent"
  ],
  "author": "Mario Zechner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunusemrejr/yunuspi.git",
    "directory": "core/coding-agent"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "private": true,
  "yunuspiCore": {
    "forkOrigin": "Pi 0.85.1",
    "originCommit": "d981de1229ef899957bbe968bc8dcda02a21f477"
  }
}
