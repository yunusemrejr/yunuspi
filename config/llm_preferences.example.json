{
  "_comment": "Explicit model/provider preferences layered over autonomous selection. Copy to ~/.pi/settings/llm_preferences.json and adapt. Most roles fall back to autonomous selection when unavailable. session_observer is optional: an absent role uses official DeepSeek Flash/high, an empty list disables it, and invalid or unavailable routes skip observation without fallback. See docs/LLM-PREFERENCES.md.",
  "version": 1,
  "models": {
    "cheap_auto": {
      "provider": "openrouter",
      "model": "qwen/qwen3-235b-a22b:free",
      "thinking": "low",
      "provider_options": {
        "routing": "auto"
      }
    },
    "strong_pinned": {
      "provider": "openrouter",
      "model": "anthropic/claude-sonnet-4",
      "thinking": "high",
      "provider_options": {
        "routing": "pinned",
        "order": ["deepinfra"],
        "allow_fallbacks": false
      }
    },
    "balanced_custom": {
      "provider": "openrouter",
      "model": "google/gemini-2.5-flash",
      "thinking": "medium",
      "provider_options": {
        "routing": "custom",
        "order": ["deepinfra", "friendli"],
        "allow_fallbacks": true
      }
    },
    "direct_deepseek": {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "thinking": "auto"
    },
    "official_deepseek_flash": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "thinking": "high"
    }
  },
  "preferences": {
    "main_session_fallback": {
      "models": ["direct_deepseek", "balanced_custom"]
    },
    "subagents": {
      "models": ["cheap_auto", "balanced_custom", "direct_deepseek"]
    },
    "council": {
      "models": ["strong_pinned", "balanced_custom", "direct_deepseek"]
    },
    "swarm": {
      "models": ["balanced_custom", "direct_deepseek", "cheap_auto"]
    },
    "fusion": {
      "models": ["cheap_auto", "balanced_custom", "direct_deepseek"]
    },
    "quality_review": {
      "models": ["cheap_auto", "balanced_custom"]
    },
    "project_review": {
      "models": ["balanced_custom", "direct_deepseek"]
    },
    "error_review": {
      "models": ["balanced_custom", "direct_deepseek", "cheap_auto"]
    },
    "session_observer": {
      "models": ["official_deepseek_flash"]
    }
  },
