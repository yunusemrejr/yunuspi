{
  "name": "yunuspi",
  "version": "0.41.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "acorn": "8.18.0",
    "electron": "44.7.0",
    "htmlparser2": "9.1.0",
    "linkedom": "0.16.11",
    "marked": "18.0.5",
    "typebox": "1.3.18",
    "undici": "8.10.0",
    "web-tree-sitter": "0.25.10",
    "yaml": "2.8.3"
  },
  "scripts": {
    "pretest": "npm run build:core",
    "test": "node scripts/test.mjs",
    "pretest:quick": "npm run build:core",
    "test:quick": "node scripts/test.mjs --quick",
    "check:public": "node scripts/check-public.mjs",
    "prepare:hooks": "git config core.hooksPath .githooks",
    "build:core": "node scripts/build-core.mjs",
    "test:fork": "node --test tests/core-independence.test.mjs",
    "start": "node desktop/launch.mjs",
    "setup:desktop": "node scripts/setup-desktop.mjs",
    "test:desktop": "node scripts/desktop-e2e.mjs"
  },
  "workspaces": [
    "core/*",
    "agent/npm"
  ]
}
