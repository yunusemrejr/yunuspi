{
  "name": "yunuspi",
  "version": "0.6.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "acorn": "8.18.0",
    "htmlparser2": "9.1.0",
    "linkedom": "0.16.11",
    "typebox": "1.3.18",
    "web-tree-sitter": "0.25.10",
    "yaml": "2.8.3",
    "undici": "8.10.0"
  },
  "scripts": {
    "pretest": "npm run build:core",
    "test": "node --test --test-concurrency=${PI_PUBLIC_TEST_CONCURRENCY:-1} tests/*.test.mjs",
    "check:public": "node scripts/check-public.mjs",
    "prepare:hooks": "git config core.hooksPath .githooks",
    "build:core": "node scripts/build-core.mjs",
    "test:fork": "node --test tests/core-independence.test.mjs"
  },
  "workspaces": [
    "core/*",
    "agent/npm"
  ]
}
